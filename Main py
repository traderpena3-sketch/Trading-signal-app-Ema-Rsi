import requests
from datetime import datetime
from zoneinfo import ZoneInfo

from kivy.app import App
from kivy.clock import Clock
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.label import Label
from kivy.uix.button import Button
from kivy.uix.spinner import Spinner
from kivy.uix.textinput import TextInput
from kivy.core.window import Window


class ForexSignalApp(App):

    def build(self):
        Window.clearcolor = (0.04, 0.07, 0.05, 1)

        root = BoxLayout(
            orientation="vertical",
            padding=15,
            spacing=10
        )

        title = Label(
            text="AI FOREX SIGNAL BOT",
            font_size=25,
            bold=True,
            size_hint_y=None,
            height=55
        )
        root.add_widget(title)

        self.api_key = TextInput(
            hint_text="Enter Twelve Data API Key",
            password=True,
            multiline=False,
            size_hint_y=None,
            height=50
        )
        root.add_widget(self.api_key)

        self.pair = Spinner(
            text="EUR/USD",
            values=[
                "EUR/USD",
                "GBP/USD",
                "USD/JPY",
                "USD/CHF",
                "AUD/USD",
                "USD/CAD",
                "NZD/USD"
            ],
            size_hint_y=None,
            height=50
        )
        root.add_widget(self.pair)

        self.timeframe = Spinner(
            text="5min",
            values=[
                "1min",
                "5min",
                "15min",
                "30min",
                "1h",
                "4h"
            ],
            size_hint_y=None,
            height=50
        )
        root.add_widget(self.timeframe)

        self.signal = Label(
            text="WAITING FOR MARKET DATA...",
            font_size=22,
            bold=True,
            size_hint_y=None,
            height=65
        )
        root.add_widget(self.signal)

        self.info = Label(
            text="Pair: -\nTimeframe: -\nEMA: -\nRSI: -\nConfidence: -\nEntry: -",
            font_size=17
        )
        root.add_widget(self.info)

        scan = Button(
            text="SCAN MARKET",
            font_size=19,
            size_hint_y=None,
            height=55
        )
        scan.bind(on_press=self.scan_market)
        root.add_widget(scan)

        return root

    def get_data(self, symbol, interval, api_key):
        url = "https://api.twelvedata.com/time_series"

        params = {
            "symbol": symbol,
            "interval": interval,
            "outputsize": 100,
            "apikey": api_key
        }

        response = requests.get(
            url,
            params=params,
            timeout=15
        )

        data = response.json()

        if "values" not in data:
            raise Exception(
                data.get("message", "Market data unavailable")
            )

        values = data["values"]

        closes = []

        for item in reversed(values):
            closes.append(float(item["close"]))

        return closes

    def ema(self, values, period):
        if len(values) < period:
            return None

        multiplier = 2 / (period + 1)

        ema_value = sum(values[:period]) / period

        for price in values[period:]:
            ema_value = (
                (price - ema_value) * multiplier
            ) + ema_value

        return ema_value

    def calculate_rsi(self, values, period=14):
        if len(values) < period + 1:
            return None

        gains = []
        losses = []

        for i in range(1, len(values)):
            change = values[i] - values[i - 1]

            if change > 0:
                gains.append(change)
                losses.append(0)
            else:
                gains.append(0)
                losses.append(abs(change))

        avg_gain = sum(gains[:period]) / period
        avg_loss = sum(losses[:period]) / period

        for i in range(period, len(gains)):
            avg_gain = (
                (avg_gain * (period - 1)) +
                gains[i]
            ) / period

            avg_loss = (
                (avg_loss * (period - 1)) +
                losses[i]
            ) / period

        if avg_loss == 0:
            return 100

        rs = avg_gain / avg_loss

        return 100 - (100 / (1 + rs))

    def scan_market(self, instance):

        api_key = self.api_key.text.strip()

        if not api_key:
            self.signal.text = "API KEY REQUIRED"
            self.info.text = "Enter your Twelve Data API key first."
            return

        symbol = self.pair.text
        interval = self.timeframe.text

        self.signal.text = "SCANNING..."

        try:
            closes = self.get_data(
                symbol,
                interval,
                api_key
            )

            if len(closes) < 30:
                raise Exception("Not enough market data")

            ema2 = self.ema(closes, 2)
            ema5 = self.ema(closes, 5)

            rsi = self.calculate_rsi(closes)

            current_price = closes[-1]

            previous_ema2 = self.ema(closes[:-1], 2)
            previous_ema5 = self.ema(closes[:-1], 5)

            signal = "WAIT"
            confidence = 50

            bullish_cross = (
                previous_ema2 <= previous_ema5
                and ema2 > ema5
            )

            bearish_cross = (
                previous_ema2 >= previous_ema5
                and ema2 < ema5
            )

            if bullish_cross and rsi is not None and rsi < 70:
                signal = "BUY"
                confidence = 85

            elif bearish_cross and rsi is not None and rsi > 30:
                signal = "SELL"
                confidence = 85

            elif ema2 > ema5 and rsi is not None and 45 < rsi < 70:
                signal = "BUY"
                confidence = 65

            elif ema2 < ema5 and rsi is not None and 30 < rsi < 55:
                signal = "SELL"
                confidence = 65

            else:
                signal = "WAIT"
                confidence = 50

            now = datetime.now(
                ZoneInfo("Asia/Dhaka")
            ).strftime("%Y-%m-%d %H:%M:%S")

            self.signal.text = signal

            self.info.text = (
                f"Pair: {symbol}\n"
                f"Timeframe: {interval}\n"
                f"Price: {current_price:.5f}\n"
                f"EMA 2: {ema2:.5f}\n"
                f"EMA 5: {ema5:.5f}\n"
                f"RSI: {rsi:.2f}\n"
                f"Confidence: {confidence}%\n"
                f"Entry: {signal}\n"
                f"Time: {now}"
            )

        except Exception as e:

            self.signal.text = "ERROR"

            self.info.text = (
                "Could not get market data.\n\n"
                + str(e)
            )


if __name__ == "__main__":
    ForexSignalApp().run()
